# ============================================================
# DeepSeek Harness DesktopShell — .gitignore
# 正式安装产物位于 %LOCALAPPDATA%\Programs\DeepSeek Harness
# DesktopShell，不会进入仓库；以下规则防止在仓库内就地
# 编译 / 运行 / 审计时产生垃圾文件。
# ============================================================

# ---- 构建 / 编译产物 ----
*.exe
*.dll
*.pdb
*.rsp
bin/
obj/
.audit-build/
.build-check/

# ---- 运行时生成物（若在仓库内运行桌面壳）----
settings.json
install-state.json
logs/
webview2-data/
*.log

# ---- 临时 / 备份文件 ----
*.tmp
*.tmp-*
*.bak

# ---- IDE / 编辑器 ----
.vs/
.vscode/
*.user
*.suo
*.userprefs
*.launch

# ---- 系统 / 杂项 ----
.DS_Store
Thumbs.db
desktop.ini
